{
  "name": "@globalwork/contracts",
  "version": "0.1.0",
  "private": true,
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "scripts": {
    "generate": "openapi-typescript openapi/globalwork.openapi.yaml -o src/generated/schema.ts",
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "tsc -p tsconfig.json --noEmit",
    "test": "echo \"Contracts package generation is verified by typecheck\""
  },
  "devDependencies": {
    "openapi-typescript": "^7.10.1",
    "typescript": "^5.8.3"
  }
}
